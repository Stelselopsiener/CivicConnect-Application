# Copy this file to .env for local development (never commit the real .env).

# Base URL of the Express API. In dev, the Vite proxy (see vite.config.js)
# forwards /api to VITE_API_PROXY_TARGET, so this can stay relative.
VITE_API_BASE_URL=/api

# Target the Vite dev-server proxy forwards /api requests to.
VITE_API_PROXY_TARGET=http://localhost:5000

# Set to "true" to run the frontend against a local mock API
# (localStorage-backed, no backend required) instead of calling the real
# Express API. Useful for frontend-only development and demos.
# Set to "false" once the real backend is available and running.
VITE_USE_MOCK_API=true
