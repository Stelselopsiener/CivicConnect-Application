# Copy to .env (never commit .env). No secrets belong in this file: every VITE_ variable is
# compiled into the JavaScript that is sent to the browser.

# true  = in-browser demo data (default; no backend needed)
# false = call the Express API described in PED section 12.2
VITE_USE_MOCK_API=true

# Path the browser calls. All endpoints are versioned under /api/v1 (PED 12.4).
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server forwards /api/* requests.
VITE_API_PROXY_TARGET=http://localhost:5000

# Shown nowhere in the UI yet; set by the release build to identify the candidate.
VITE_RELEASE=m3-rc1
